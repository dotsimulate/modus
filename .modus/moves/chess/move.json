{
  "name": "chess",
  "label": "Play chess",
  "description": "Play a game of chess. Pick your color from the widget, then start the game.",
  "icon": "crown",
  "mode": "inline",
  "inputs": [],
  "api": {
    "tokenPrefix": "chess",
    "ops": {
      "setup": {
        "description": "Set game config before starting (color choice)",
        "schema": {
          "type": "object",
          "properties": {
            "userColor": { "type": "string", "enum": ["w", "b"], "description": "User's color: w or b" }
          },
          "required": ["userColor"]
        }
      },
      "move": {
        "description": "Submit a chess move in SAN notation",
        "schema": {
          "type": "object",
          "properties": {
            "move": { "type": "string", "description": "SAN notation (e.g. e4, Nf3, O-O)" }
          },
          "required": ["move"]
        }
      },
      "board": {
        "description": "View current board state as ASCII"
      },
      "resign": {
        "description": "Resign the current game"
      }
    },
    "state": {
      "persist": true
    }
  },
  "submit": {
    "required": false
  },
  "session": {
    "afterSubmit": "continue"
  },
  "widget": {
    "component": "widget.tsx",
    "panel": "right",
    "label": "Chess",
    "icon": "crown",
    "autoOpen": true,
    "mountOnAttach": true
  },
  "tags": ["game", "chess"]
}
