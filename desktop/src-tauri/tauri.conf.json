{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modus",
  "version": "0.3.2-alpha.3",
  "identifier": "com.modus.desktop",
  "build": {
    "beforeDevCommand": "bun run stage-managed-backend.ts --dev",
    "beforeBuildCommand": "bun run stage-managed-backend.ts",
    "devUrl": "http://localhost:5180",
    "frontendDist": "../../harness/ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Modus",
        "url": "index.html?modusDesktop=1&modusDiscover=local",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https: wss:; img-src 'self' data: blob: http://127.0.0.1:* http://localhost:* https:; media-src 'self' data: blob: http://127.0.0.1:* http://localhost:* https:; frame-src 'self' blob: http://127.0.0.1:* http://localhost:* https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' blob:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["modus"]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["txt"],
        "name": "Text document",
        "description": "Text document",
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "active": true,
    "publisher": "dotsimulate",
    "copyright": "Copyright © 2026 dotsimulate",
    "licenseFile": "../installer-license.txt",
    "shortDescription": "Local-first AI agent harness",
    "longDescription": "Modus runs its agent harness on your machine, composing prompts and giving agents controlled access to your projects. Providers and integrations you configure can receive content.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/bun", "binaries/modus"],
    "resources": {
      "resources/modus/": "modus/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
