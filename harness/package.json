{
  "name": "modus-harness",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "modus": "./cli.ts"
  },
  "scripts": {
    "cli": "bun run cli.ts",
    "dev": "bun run dev.ts",
    "start": "bun run index.ts",
    "watch": "bun run watchdog.ts",
    "watch:dev": "MODUS_WATCH_FILES=1 bun run watchdog.ts",
    "docs:sdk": "typedoc --options sdk/typedoc.json",
    "docs:generate": "bun run scripts/generate-docs.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "hono": "4.12.31",
    "simple-git": "3.36.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.170",
    "@anthropic-ai/sdk": "^0.100.1",
    "@google/gemini-cli-core": "0.32.1",
    "@mariozechner/pi-agent-core": "^0.56.2",
    "@mariozechner/pi-ai": "^0.56.2",
    "@mariozechner/pi-coding-agent": "^0.56.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@resvg/resvg-js": "^2.6.2",
    "hono": "^4.12.31",
    "simple-git": "^3.36.0",
    "zod": "^4.3.6"
  }
}
