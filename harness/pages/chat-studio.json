{
  "id": "chat-studio",
  "title": "Chat Studio",
  "fullscreen": true,
  "nav": false,
  "padding": 0,
  "layout": {
    "kind": "scope",
    "bindUrlSession": true,
    "context": {
      "sessionId": null
    },
    "children": [{
      "kind": "split",
      "axis": "horizontal",
      "sizes": [1, 3, 1],
      "collapsible": [true, false, true],
      "children": [
        {
          "kind": "tabs",
          "id": "cs-left-tabs",
          "editable": true,
          "children": [
            {
              "kind": "widget",
              "widget": { "type": "session-history", "id": "cs-history" },
              "publish": { "selectedSession": "sessionId" },
              "subscribe": { "selectedSession": "sessionId" }
            },
            {
              "kind": "widget",
              "widget": { "type": "profiles-manager", "id": "cs-profiles" },
              "publish": { "selectedSession": "sessionId" }
            },
            {
              "kind": "widget",
              "widget": { "type": "moves", "id": "cs-moves" }
            },
            {
              "kind": "widget",
              "widget": { "type": "actions-manager", "id": "cs-actions" }
            }
          ]
        },
        {
          "kind": "split",
          "axis": "vertical",
          "sizes": ["auto", 1, "auto"],
          "children": [
            {
              "kind": "tabs",
              "id": "cs-center-tabs",
              "showWhen": { "sessionId": null },
              "children": [
                {
                  "kind": "widget",
                  "widget": { "type": "new-session", "id": "cs-new" },
                  "publish": { "selectedSession": "sessionId" }
                },
                {
                  "kind": "widget",
                  "widget": { "type": "inbox", "id": "cs-inbox" },
                  "publish": { "selectedSession": "sessionId" }
                }
              ]
            },
            {
              "kind": "widget",
              "widget": { "type": "session-chat", "id": "cs-chat" },
              "hideWhen": { "sessionId": null }
            },
            {
              "kind": "widget",
              "widget": { "type": "composer", "id": "cs-composer", "persistOpen": true },
              "hideWhen": { "sessionId": null }
            }
          ]
        },
        {
          "kind": "tabs",
          "editable": true,
          "target": true,
          "children": [
            {
              "kind": "widget",
              "widget": { "type": "session-sidebar", "id": "cs-sidebar" }
            },
            {
              "kind": "widget",
              "widget": { "type": "agent-activity", "id": "cs-activity" }
            },
            {
              "kind": "widget",
              "widget": { "type": "session-edits", "id": "cs-edits" }
            },
            {
              "kind": "widget",
              "widget": { "type": "code-editor", "id": "cs-editor" }
            },
            {
              "kind": "widget",
              "widget": { "type": "session-terminal", "id": "cs-terminal" }
            },
            {
              "kind": "widget",
              "widget": { "type": "profile-card", "id": "cs-profile-card" }
            }
          ]
        }
      ]
    }]
  },
  "layouts": {
    "mobile": {
      "kind": "scope",
      "bindUrlSession": true,
      "context": {
        "sessionId": null
      },
      "children": [{
        "kind": "split",
        "axis": "vertical",
        "sizes": [1, "auto"],
        "children": [
          {
            "kind": "tabs",
            "id": "cs-mobile-tabs",
            "editable": true,
            "target": true,
            "activeTab": "cm-chat",
            "handles": ["open-file", "open-terminal", "open-move", "close-move", "focus-tab"],
            "children": [
              {
                "kind": "widget",
                "widget": { "type": "session-chat", "id": "cm-chat" },
                "hideWhen": { "sessionId": null }
              },
              {
                "kind": "widget",
                "widget": { "type": "session-history", "id": "cm-history", "focusTabOnSelect": "cm-chat" },
                "publish": { "selectedSession": "sessionId" },
                "subscribe": { "selectedSession": "sessionId" }
              },
              {
                "kind": "widget",
                "widget": { "type": "new-session", "id": "cm-new" },
                "publish": { "selectedSession": "sessionId" },
                "showWhen": { "sessionId": null }
              },
              {
                "kind": "widget",
                "widget": { "type": "session-sidebar", "id": "cm-sidebar" },
                "hideWhen": { "sessionId": null }
              },
              {
                "kind": "widget",
                "widget": { "type": "agent-activity", "id": "cm-activity" },
                "hideWhen": { "sessionId": null }
              },
              {
                "kind": "widget",
                "widget": { "type": "session-edits", "id": "cm-edits" },
                "hideWhen": { "sessionId": null }
              },
              {
                "kind": "widget",
                "widget": { "type": "code-editor", "id": "cm-editor" },
                "hideWhen": { "sessionId": null }
              },
              {
                "kind": "widget",
                "widget": { "type": "session-terminal", "id": "cm-terminal" },
                "hideWhen": { "sessionId": null }
              },
              {
                "kind": "widget",
                "widget": { "type": "profile-card", "id": "cm-profile-card" },
                "hideWhen": { "sessionId": null }
              },
              {
                "kind": "widget",
                "widget": { "type": "profiles-manager", "id": "cm-profiles" },
                "publish": { "selectedSession": "sessionId" }
              },
              {
                "kind": "widget",
                "widget": { "type": "moves", "id": "cm-moves" }
              },
              {
                "kind": "widget",
                "widget": { "type": "actions-manager", "id": "cm-actions" }
              }
            ]
          },
          {
            "kind": "widget",
            "widget": { "type": "composer", "id": "cm-composer", "persistOpen": true },
            "hideWhen": { "sessionId": null }
          }
        ]
      }]
    }
  }
}
