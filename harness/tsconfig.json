{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "./*.ts",
    "./providers/**/*.ts",
    "./scripts/**/*.ts",
    "./actions/**/*.ts",
    "./moves/**/*.ts"
  ],
  "exclude": [
    "./ui",
    // This CLI consumes browser-owned pure helpers. Those helpers are checked
    // by the UI config; importing them here would also merge the UI's React DOM
    // globals into Bun's fetch/stream globals for every backend module.
    "./scripts/lint-pages.ts",
    "./node_modules"
  ]
}
