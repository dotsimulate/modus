# Dependencies
node_modules/

# Extensions (third-party cloned repos, local installs)
extensions/

# Python
__pycache__/
*.py[oc]
.venv/
*.egg-info/

# Bun's package text lockfiles are cross-platform release inputs.
# Keep move-local/generated locks ignored unless a move explicitly owns one.
bun.lock
!/bun.lock
!/desktop/bun.lock
!/harness/bun.lock
!/harness/ui/bun.lock
uv.lock

# SQLite runtime files
*.db
*.db-shm
*.db-wal

# Build output
dist/
dist-ssr/
out/
build/
target/
desktop/src-tauri/gen/schemas/
*.tgz
*.tsbuildinfo

# Environment / secrets
.env
.env.*
*.env
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
*.jks
*.keystore
*.asc
*.gpg
id_rsa
id_dsa
id_ecdsa
id_ed25519
.npmrc

# MCP config (has machine-specific absolute paths)
.mcp.json

# Project-local .modus/ — runtime/personal data, mostly ignored
# Selectively track example moves (chess, wordle, council, nano-banana) for reference
.modus/*
!.modus/moves/
.modus/moves/*
!.modus/moves/chess/
!.modus/moves/wordle/
!.modus/moves/nano-banana/
!.modus/moves/council/
.modus/moves/chess/state/
.modus/moves/wordle/state/
.modus/moves/nano-banana/state/
.modus/moves/nano-banana/outputs/
.modus/moves/council/state/
.modus/moves/death/state/
.modus/state/

# Scraps, research, and local experiments
TODO/
harness/TODO/
research_output/
research_scraps/
test_website/

# Generated docs (reproduced by `bun run docs:sdk` from JSDoc source)
harness/docs/sdk/api/

# Lock files (Bun uses bun.lockb; npm lock is only for devDeps like typedoc)
harness/package-lock.json

# Harness runtime (auto-generated, personal per-user)
# NOTE: user-owned profile state now lives in ~/.modus/profiles/ — see
# harness/modus-home.ts. Nothing writes inside harness/profiles/ at runtime.
# harness/actions/ is a personal scratch root: it loads in a source checkout and
# is deliberately NOT staged into a build. Shipped actions are tracked content
# under harness/core-actions/ — see desktop/stage-managed-backend.ts.
harness/actions/
harness/actions/*/output/
harness/actions/*/gallery/
# Run artifacts land beside the action they came from, including under the
# tracked core root.
harness/core-actions/*/output/
harness/core-actions/*/gallery/
harness/schedules/
harness/TODO/
TODO/

# Legacy harness/profiles/ leftovers from before the ~/.modus/ migration
# (personal runtime data — only README.md is tracked)
harness/profiles/state/
harness/profiles/users/
harness/profiles/ui/
harness/profiles/.history/
harness/profiles/_projects.json

# Generated build stamp
harness/ui/.modus-deps.stamp

# Public contributor skills. Packaged copies live under harness/templates/skills/.
# Other root-local skills remain private unless explicitly curated here.
.claude/skills/*
!.claude/skills/create-action/
!.claude/skills/create-mission/
!.claude/skills/create-move/
!.claude/skills/create-profile/

# Harness-local .claude scaffolding (personal, not part of the release surface)
harness/.claude/

# Claude settings (personal per-user, any depth)
**/.claude/settings.json
**/.claude/settings.local.json

# Sandbox — local experiments, not for commit (e.g. Remotion)
sandbox/

# Archive (local reference docs)
archive/

# Logs
*.log

# Generated Tauri managed-backend staging (rebuilt before every desktop build)
desktop/src-tauri/binaries/
desktop/src-tauri/resources/
logs/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
*.stackdump

# Editor / IDE
.idea/
.cursor/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace

# Coverage / test artifacts
coverage/
*.lcov
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
